# Production environment for /opt/clario/.env
# Copy: sudo -u clario cp deploy/env.production.example /opt/clario/.env
# Then fill secrets. chmod 600 /opt/clario/.env

# --- Database (required on VPS) ---
DATABASE_URL=postgresql+asyncpg://clario:CHANGE_ME@127.0.0.1:5432/clario

# Encrypt Zoho tokens at rest (generate on the VPS):
#   /opt/clario/.venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CLARIO_ENCRYPTION_KEY=

# JWT signing secret (generate on the VPS):
#   openssl rand -hex 32
CLARIO_JWT_SECRET=
CLARIO_JWT_HOURS=72
MULTI_TENANT_ENABLED=true

# --- Zoho Books OAuth (optional platform fallback) ---
# Prefer per-workspace Client ID + Secret in the Clario UI.
# Every customer Zoho app must register this exact redirect URI:
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=https://server.crita.in/clario/oauth/zoho/callback

ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_BASE_URL=https://www.zohoapis.in/books/v3

# Leave empty in multi-tenant mode (tokens live in Postgres per workspace)
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=

# --- LLM ---
LLM_PROVIDER=groq
GROQ_API_KEY=
# Use a model your Groq key can access (list via GET https://api.groq.com/openai/v1/models)
GROQ_MODEL=groq/openai/gpt-oss-20b
# llama-3.1-8b-instant is often unavailable; pick an id from GET /openai/v1/models for your key.

# Optional Gemini fallback
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- App (bind localhost only; nginx terminates HTTPS on server.crita.in) ---
CLARIO_HOST=127.0.0.1
CLARIO_PORT=8000
CLARIO_LOG_LEVEL=INFO
CLARIO_DATA_DIR=/opt/clario/.data

# Public path prefix (must match nginx location and frontend/config.js)
# CLARIO_BASE_PATH is documented for ops; the browser reads frontend/config.js
# window.CLARIO_BASE = "/clario";
