    # ========== SMC Task Management DEV==========
   location /client-trial/smc-task-management/ {
        proxy_pass http://localhost:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

        # ========== SSL Configuration ==========
        listen 443 ssl; # managed by Certbot
        ssl_certificate /etc/letsencrypt/live/server.crita.in/fullchain.pem; # managed by Certbot
        ssl_certificate_key /etc/letsencrypt/live/server.crita.in/privkey.pem; # managed by Certbot
        include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
        ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
    }

# Redirect HTTP to HTTPS
server {
    if ($host = server.crita.in) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    # Handle reverse proxying for Let's Encrypt validation
    listen 80;
    server_name server.crita.in;
    return 404; # managed by Certbot
}
