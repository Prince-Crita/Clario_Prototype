server {
    server_name server.crita.in;

    client_max_body_size 50M;

    root /opt/www/server.crita.in/html;
    index index.html index.htm;

    location / {
        try_files $uri $uri/ =404;
    }

    # ========== pgAdmin ==========
    location /pgadmin/ {
            rewrite ^/pgadmin(/.*)$ $1 break;
        proxy_pass http://127.0.0.1:5050/;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Host $host;
        proxy_set_header X-Script-Name /pgadmin;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_redirect off;
    }

    # ========== ERP Frontend Demo ==========
    location /tbc/test/ {
        alias /opt/www/tbc-fe-demo/;
        index index.html;
        try_files $uri $uri/ /tbc/test/index.html;
    }

    # ========== ERP Frontend Prod ==========
    location /tbc/ {
        alias /opt/www/tbc-fe/;
        index index.html;
        try_files $uri $uri/ /tbc/index.html;
    }


    # ========== ERP Backend ==========
    location /erp-be/api {
            rewrite /api/(.*) /$1  break;
        proxy_pass http://localhost:3009/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }

    # ========== ERP Uploads ==========
    location /erp-be/uploads/ {
        alias /opt/erp/uploads/;
        expires 1y;
        add_header Cache-Control "public";

        # Security: block executable scripts
        location ~* \.(php|pl|py|jsp|asp|sh|cgi)$ {
            deny all;
        }
    }

     # ========== ERP Backend Prod==========
    location /erp-be-prod/api {
        rewrite /api/(.*) /$1  break;
        proxy_pass http://localhost:3010/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }

    # ========== ERP Uploads ==========
    location /erp-be-prod/uploads/ {
        alias /opt/erp-prod/uploads/;
        expires 1y;
        add_header Cache-Control "public";

        # Security: block executable scripts
        location ~* \.(php|pl|py|jsp|asp|sh|cgi)$ {
            deny all;
        }
    }

    # ========== Crita Files==========
        location /crita-files/ {
        alias /opt/crita-files/;
        expires 1y;
        add_header Cache-Control "public";

            # Security: block executable scripts
            location ~* \.(php|pl|py|jsp|asp|sh|cgi)$ {
                deny all;
            }
        }


    # ========== Support Ticket Frontend ==========
    location /support-ticket/dev {
        alias /opt/www/support-ticket-dev/;
        index index.html;
        try_files $uri $uri/ /support-ticket/dev/index.html;
    }

    # ========== Bidding Frontend ==========
    location /bidding/dev {
        alias /opt/www/bidding-dev/;
        index index.html;
        try_files $uri $uri/ /bidding/dev/index.html;
    }

    location /bidding {
        alias /opt/www/bidding-prod/;
        index index.html;
        try_files $uri $uri/ /bidding/index.html;
    }

    # ========== Bidding Backend Dev==========
