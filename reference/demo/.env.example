# --- Database (multi-tenant) ---
# Local default is SQLite under .data/clario.db when DATABASE_URL is empty.
# Production: PostgreSQL
# DATABASE_URL=postgresql+asyncpg://clario:clario@localhost:5432/clario
DATABASE_URL=

# Encrypt Zoho tokens at rest (required in production).
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CLARIO_ENCRYPTION_KEY=

# JWT signing secret for user sessions
CLARIO_JWT_SECRET=change-me-in-production
CLARIO_JWT_HOURS=72
MULTI_TENANT_ENABLED=true

# --- Zoho Books OAuth (optional platform fallback) ---
# Prefer per-workspace Client ID + Secret in the UI so each customer org uses its own Zoho app.
# These env values are only a fallback when a workspace has not set its own credentials.
# After editing, reload with: ./scripts/restart.sh
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=http://localhost:8000/oauth/zoho/callback
# On VPS: https://clario.crita.in/oauth/zoho/callback — every customer Zoho app must register this URI.

# Default data center for new workspaces (each tenant can store its own after connect)
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_BASE_URL=https://www.zohoapis.in/books/v3

# Legacy single-tenant fallback (optional; multi-tenant stores tokens in DB)
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=

# --- LLM (default: Groq via LiteLLM) ---
# Get a key at https://console.groq.com/keys
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=groq/openai/gpt-oss-20b
# Note: llama-3.1-8b-instant is not available on many Groq keys (decommissioned / enterprise).
# List models your key can use: curl -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
# Alternatives on typical keys: groq/openai/gpt-oss-20b | groq/openai/gpt-oss-120b | groq/qwen/qwen3.8-27b

# Optional Gemini fallback (set LLM_PROVIDER=gemini)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- App ---
CLARIO_HOST=127.0.0.1
CLARIO_PORT=8000
CLARIO_LOG_LEVEL=INFO
CLARIO_DATA_DIR=.data
