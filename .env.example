# Clario — environment template (PLACEHOLDERS ONLY)
# Copy to `.env` (or `.env.local` for personal overrides). Both are git-ignored.
# Never put real secrets or passwords in this file.
# See docs/FINAL_ARCHITECTURE_PLAN.md §39.

# --- App ---
APP_ENV=development
APP_BASE_URL=http://localhost:5173
LOG_LEVEL=INFO
# auto = json in production, console elsewhere | json | console
LOG_FORMAT=auto

# --- Database (PostgreSQL) ---
# Any PostgreSQL URL works, exactly as the provider issues it (postgresql://…); the app adapts it
# for asyncpg itself. Local development (this file's default):
#   DATABASE_URL=postgresql+asyncpg://<db_user>:<db_password>@localhost:5432/clario_dev
# Neon: paste the POOLED connection string (host contains "-pooler") into .env.local, which
# overrides this file and is git-ignored; on Vercel set it as an environment variable. Delete the
# line from .env.local to fall back to the local database. Never commit a real URL.
#   DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
DATABASE_URL=postgresql+asyncpg://<db_user>:<db_password>@localhost:5432/clario_dev
# Optional. The direct (unpooled) endpoint, used for migrations. Derived from a Neon pooled URL
# when not set (the same host without "-pooler").
DATABASE_URL_UNPOOLED=
# Must end in `_test`; the test harness refuses any other database. Always a local database.
TEST_DATABASE_URL=postgresql+asyncpg://<db_user>:<db_password>@localhost:5432/clario_test
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# Serverless hosting (Vercel) only: a function may be frozen once its response is sent, so the
# Zoho import runs inside the request instead of after it, and opening a page no longer starts a
# background refresh (use the Sync button). Leave false for local development and servers.
SYNC_INLINE=false

# --- Sessions & encryption ---
# python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(64)).decode())"
SESSION_SECRET=
SESSION_IDLE_HOURS=12
SESSION_ABSOLUTE_DAYS=7
SESSION_COOKIE_SECURE=false
# Comma-separated Fernet keys; the first encrypts, all decrypt (rotation). App will not start if empty.
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEYS=

# --- AI: one provider at a time (groq | openrouter); the assistant is the same with either ---
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# OpenRouter: one key, many models. The default is a free tool-calling model for development;
# openai/gpt-oss-120b (the evaluated model) needs OpenRouter credits.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOOL_ROUNDS=6

# --- Zoho Books (Crita's Server-based Application from Zoho API Console) ---
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Must match the redirect URI registered in Zoho API Console exactly.
ZOHO_REDIRECT_URI=http://localhost:5173/api/v1/oauth/zoho-books/callback
# Data center used when the client does not choose one: in | com | eu | au | jp | ca
ZOHO_DEFAULT_REGION=in
# Read-only scopes only. Verified in Phase 0 (reports need ZohoBooks.reports.READ).
ZOHO_SCOPES=ZohoBooks.settings.READ,ZohoBooks.invoices.READ,ZohoBooks.contacts.READ,ZohoBooks.customerpayments.READ,ZohoBooks.expenses.READ,ZohoBooks.accountants.READ,ZohoBooks.reports.READ,ZohoBooks.banking.READ,ZohoBooks.bills.READ,ZohoBooks.vendorpayments.READ
ZOHO_REQUESTS_PER_MINUTE=60
ZOHO_MAX_PAGES=100

# --- Finance data mirror ---
FINANCE_STALE_AFTER_MINUTES=15
FINANCE_REFRESH_COOLDOWN_SECONDS=60
# Development/test only: serve fixture data instead of Zoho. Refused when APP_ENV=production.
FINANCE_FIXTURE_SOURCE=false
# Which fixture: golden (the director PDFs' real amounts, for dashboard checks) or evaluation
# (synthetic TEST figures, the one to use when trying the assistant: it is sent to Groq).
FINANCE_FIXTURE_DATASET=golden
